{
  "name": "dsh-plugin-lx-music",
  "version": "0.4.0",
  "description": "落雪音乐（LX Music）内嵌歌词 + 播放控制：歌词内嵌到 DSH 右侧壁纸带（当前行 + 前后各两句），歌词正上方的胶囊放上一首/播放暂停/下一首；输入框按钮临时收起/展开歌词，设置页可关掉改回落雪桌面歌词窗。不接管播放。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "lx-music",
    "lyrics",
    "windows"
  ],
  "os": [
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afawfawffaf/dsh-plugin-lx-music.git"
  },
  "homepage": "https://github.com/afawfawffaf/dsh-plugin-lx-music#readme",
  "bugs": {
    "url": "https://github.com/afawfawffaf/dsh-plugin-lx-music/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/no-bom.mjs && node test/lrc.mjs && node test/control-route.mjs && node test/host-routes.mjs && node test/client-bundle.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "MIT"
}
